// Genera mapa estático con zoom más alejado para el PDF
function generarMapaEstaticoPDF(lat, lon, zm, w, h){
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d');

  // Fondo degradado tipo mapa
  const grad = ctx.createLinearGradient(0, 0, w, h);
  grad.addColorStop(0, '#e8f4f8');
  grad.addColorStop(1, '#d4e9f7');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, w, h);

  // Grid de calles — más denso para dar sensación de mayor zoom out
  ctx.strokeStyle = 'rgba(255,255,255,0.65)';
  ctx.lineWidth = 0.8;
  const gridStep = 28;
  for(let x = 0; x < w; x += gridStep){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }
  for(let y = 0; y < h; y += gridStep){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }

  // Avenidas principales (líneas más gruesas)
  ctx.strokeStyle = 'rgba(255,255,255,0.5)';
  ctx.lineWidth = 2.5;
  [80,200,340,480,600].forEach(x=>{ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); });
  [70,170,280,370,460,550].forEach(y=>{ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); });

  // Manzanas — más pequeñas y abundantes (zoom alejado)
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  const bw = 22, bh = 18;
  for(let x = 8; x < w - bw; x += gridStep){
    for(let y = 8; y < h - bh; y += gridStep){
      ctx.beginPath(); ctx.roundRect(x+3, y+3, bw, bh, 2); ctx.fill();
    }
  }

  // Parques/manzanas verdes aleatorias
  ctx.fillStyle = 'rgba(134,200,160,0.25)';
  [[55,80,50,40],[280,150,60,45],[500,90,55,50],[160,300,65,40],[420,340,50,45],[650,200,55,40]].forEach(([x,y,pw,ph])=>{
    ctx.beginPath(); ctx.roundRect(x,y,pw,ph,4); ctx.fill();
  });

  // Borde
  ctx.strokeStyle = '#b8d4e8'; ctx.lineWidth = 2;
  ctx.strokeRect(1,1,w-2,h-2);

  const cx = w/2, cy = h/2;

  // Radio 500m — más pequeño visualmente (zoom out)
  const radioPx = 45;
  ctx.beginPath(); ctx.arc(cx, cy, radioPx, 0, Math.PI*2);
  ctx.fillStyle = 'rgba(37,99,235,0.07)'; ctx.fill();
  ctx.strokeStyle = 'rgba(37,99,235,0.35)'; ctx.lineWidth = 1.2;
  ctx.setLineDash([5,3]); ctx.stroke(); ctx.setLineDash([]);

  // Radio 1km (referencia extra)
  ctx.beginPath(); ctx.arc(cx, cy, radioPx*2, 0, Math.PI*2);
  ctx.strokeStyle = 'rgba(37,99,235,0.12)'; ctx.lineWidth = 0.8;
  ctx.setLineDash([4,4]); ctx.stroke(); ctx.setLineDash([]);

  // Sombra pin
  ctx.beginPath(); ctx.ellipse(cx, cy+18, 6, 2.5, 0, 0, Math.PI*2);
  ctx.fillStyle = 'rgba(0,0,0,0.12)'; ctx.fill();

  // Marcador más pequeño (acorde al zoom)
  ctx.beginPath(); ctx.arc(cx, cy-5, 10, 0, Math.PI*2);
  ctx.fillStyle = '#1d4ed8'; ctx.fill();
  ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx-6, cy+3); ctx.lineTo(cx, cy+17); ctx.lineTo(cx+6, cy+3);
  ctx.fillStyle = '#1d4ed8'; ctx.fill();
  ctx.beginPath(); ctx.arc(cx, cy-5, 3.5, 0, Math.PI*2);
  ctx.fillStyle = '#fff'; ctx.fill();

  // Etiqueta coordenada
  const label = lat.toFixed(5)+'°, '+lon.toFixed(5)+'°';
  ctx.font = 'bold 11px Inter, sans-serif';
  const tw = ctx.measureText(label).width;
  const lx = Math.min(cx+16, w-tw-14);
  const ly = cy-18;
  ctx.fillStyle = 'rgba(255,255,255,0.93)';
  ctx.beginPath(); ctx.roundRect(lx-5, ly-13, tw+10, 18, 4); ctx.fill();
  ctx.strokeStyle = '#dbeafe'; ctx.lineWidth = 1; ctx.stroke();
  ctx.fillStyle = '#1d4ed8'; ctx.fillText(label, lx, ly);

  // Etiqueta zona
  ctx.font = '10px Inter, sans-serif';
  const zw = ctx.measureText(zm).width;
  ctx.fillStyle = 'rgba(255,255,255,0.93)';
  ctx.beginPath(); ctx.roundRect(lx-5, ly+7, zw+10, 16, 4); ctx.fill();
  ctx.strokeStyle = '#dbeafe'; ctx.stroke();
  ctx.fillStyle = '#374151'; ctx.fillText(zm, lx, ly+18);

  // Escala — 500m y 1km
  const scaleX = 16, scaleY = h - 18;
  ctx.strokeStyle = '#1d4ed8'; ctx.lineWidth = 1.5; ctx.setLineDash([]);
  ctx.beginPath(); ctx.moveTo(scaleX, scaleY); ctx.lineTo(scaleX+60, scaleY); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(scaleX, scaleY-4); ctx.lineTo(scaleX, scaleY+4); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(scaleX+60, scaleY-4); ctx.lineTo(scaleX+60, scaleY+4); ctx.stroke();
  ctx.font = '9px Inter, sans-serif'; ctx.fillStyle = '#1d4ed8'; ctx.textAlign='center';
  ctx.fillText('500 m', scaleX+30, scaleY-6);
  ctx.textAlign = 'left';

  // Leyenda radios
  ctx.font = '9px Inter, sans-serif'; ctx.fillStyle = 'rgba(37,99,235,0.7)';
  ctx.fillText('· Radio 500 m', w-90, h-22);
  ctx.fillStyle = 'rgba(37,99,235,0.4)';
  ctx.fillText('· Radio 1 km', w-90, h-11);

  // Atribución
  ctx.font = '8px Inter, sans-serif'; ctx.fillStyle = 'rgba(100,116,139,0.6)';
  ctx.fillText('© AVM Dashboard · Mapa ilustrativo, no georreferenciado', scaleX+80, h-8);

  return canvas.toDataURL('image/png');
}

async function descargarPDF(){
  if(typeof html2canvas==='undefined' || typeof window.jspdf==='undefined'){
    alert('No se pudieron cargar las librerías necesarias para generar el PDF. Verifica tu conexión a internet.');
    return;
  }
  actualizarReporte(); renderReporteZM();

  const {jsPDF} = window.jspdf;
  const pdf = new jsPDF('p','mm','a4');
  const pageW=210, pageH=297, margin=10;
  const imgW = pageW - margin*2;

  // ── PÁGINA 1: Reporte ejecutivo (KPIs + resumen + vivienda + modelo + gráfica ZM) ──
  // Ocultamos lectura+metodología temporalmente para que quepan en su propia sección
  const secLectura = document.querySelector('.report-section:nth-last-child(3)');
  const secMeto    = document.querySelector('.report-section:nth-last-child(2)');
  const footer     = document.querySelector('.report-footer');

  if(secLectura) secLectura.style.display='none';
  if(secMeto)    secMeto.style.display='none';
  if(footer)     footer.style.display='none';
  const mapEl = document.getElementById('ubicacion-map');
  if(mapEl) mapEl.style.visibility='hidden';

  const root = document.getElementById('report-content');
  const c1 = await html2canvas(root,{scale:2,useCORS:true,allowTaint:false,backgroundColor:'#f0f2f5',logging:false});

  // Restaurar
  if(secLectura) secLectura.style.display='';
  if(secMeto)    secMeto.style.display='';
  if(footer)     footer.style.display='';
  if(mapEl)      mapEl.style.visibility='visible';

  const pagePixelH = Math.floor(c1.width*(pageH-margin*2)/imgW);
  let sourceY=0, firstPage=true;
  while(sourceY < c1.height){
    if(!firstPage) pdf.addPage();
    firstPage=false;
    const sliceH = Math.min(pagePixelH, c1.height-sourceY);
    const sl = document.createElement('canvas');
    sl.width=c1.width; sl.height=sliceH;
    sl.getContext('2d').drawImage(c1,0,sourceY,c1.width,sliceH,0,0,c1.width,sliceH);
    pdf.addImage(sl.toDataURL('image/png'),'PNG',margin,margin,imgW,sliceH*imgW/c1.width);
    sourceY+=sliceH;
  }

  // ── PÁGINA 2: Mapa de ubicación ──
  const r = ultimoResultado;
  if(r.lat!=null && r.lon!=null){
    pdf.addPage();

    // Header oscuro
    pdf.setFillColor(15,23,42);
    pdf.rect(0,0,pageW,24,'F');
    pdf.setFont('helvetica','bold'); pdf.setFontSize(13); pdf.setTextColor(255,255,255);
    pdf.text('Ubicación evaluada', margin, 15);
    pdf.setFont('helvetica','normal'); pdf.setFontSize(9); pdf.setTextColor(147,197,253);
    pdf.text('AVM · Sistema de Apoyo a la Decisión Inmobiliaria', margin+82, 15);

    // Datos en 3 columnas
    const cols = [[margin,'Latitud',r.lat.toFixed(6)+'°'],[margin+55,'Longitud',r.lon.toFixed(6)+'°'],[margin+110,'Zona metropolitana',r.zm],[margin+155,'Tipo',r.tipo==='house'?'Casa':r.tipo==='apartment'?'Dpto.':'PH']];
    cols.forEach(([x,lbl,val])=>{
      pdf.setFont('helvetica','normal'); pdf.setFontSize(8); pdf.setTextColor(107,114,128);
      pdf.text(lbl, x, 32);
      pdf.setFont('helvetica','bold'); pdf.setFontSize(10); pdf.setTextColor(17,24,39);
      pdf.text(val, x, 39);
    });

    // Línea separadora
    pdf.setDrawColor(229,231,235); pdf.setLineWidth(0.3);
    pdf.line(margin, 44, pageW-margin, 44);

    // Mapa estático — más grande, zoom alejado
    const mapPxW = Math.round(imgW * 4.5);
    const mapPxH = Math.round(150 * 4.5);
    const mapImg = generarMapaEstaticoPDF(r.lat, r.lon, r.zm, mapPxW, mapPxH);
    pdf.addImage(mapImg,'PNG',margin,48,imgW,150);
    pdf.setDrawColor(203,213,225); pdf.setLineWidth(0.4);
    pdf.rect(margin,48,imgW,150);

    // Nota
    pdf.setFont('helvetica','normal'); pdf.setFontSize(8); pdf.setTextColor(156,163,175);
    pdf.text('Representación ilustrativa. El marcador indica las coordenadas ingresadas. El círculo punteado representa un radio de 500 m y el exterior 1 km. No georreferenciado.', margin, 202, {maxWidth:imgW});
  }

  // ── PÁGINA 3: Lectura ejecutiva + Metodología + Footer ──
  if(secLectura && secMeto){
    pdf.addPage();

    // Ocultar todo excepto lectura y metodología
    const head   = document.querySelector('.report-head');
    const body   = document.querySelector('.report-body');
    // Mostrar solo las dos secciones finales
    const allSections = document.querySelectorAll('.report-body > *');
    const toHide = [];
    allSections.forEach(el=>{
      if(el!==secLectura && el!==secMeto){ el.style.display='none'; toHide.push(el); }
    });
    if(head)   head.style.display='none';
    if(footer) footer.style.display='block';

    const c3 = await html2canvas(root,{scale:2,useCORS:true,allowTaint:false,backgroundColor:'#f0f2f5',logging:false});

    // Restaurar
    toHide.forEach(el=>el.style.display='');
    if(head) head.style.display='';

    let sy3=0, fp3=true;
    while(sy3 < c3.height){
      if(!fp3) pdf.addPage();
      fp3=false;
      const slH = Math.min(pagePixelH, c3.height-sy3);
      const sl3 = document.createElement('canvas');
      sl3.width=c3.width; sl3.height=slH;
      sl3.getContext('2d').drawImage(c3,0,sy3,c3.width,slH,0,0,c3.width,slH);
      pdf.addImage(sl3.toDataURL('image/png'),'PNG',margin,margin,imgW,slH*imgW/c3.width);
      sy3+=slH;
    }
  }

  pdf.save('reporte_valuacion_'+new Date().toISOString().slice(0,10)+'.pdf');
}

</script>

