function colorMape(v){
  if(v==null)return'#c0bfb7';
  const t=Math.max(0,Math.min(1,(v-11)/(49-11)));
  const r=Math.round(26+t*(235-26)),g=Math.round(175+t*(83-175)),b=Math.round(212+t*(30-212));
  return`rgb(${r},${g},${b})`;
}
function colorCrec(v){
  if(v==null)return'#c0bfb7';
  const t=Math.max(0,Math.min(1,(v-41)/(95-41)));
  const r=Math.round(42+t*(235-42)),g=Math.round(120+t*(83-120)),b=Math.round(212+t*(30-212));
  return`rgb(${r},${g},${b})`;
}
function stateMapeKey(nm){return STATE_MAP[nm]||nm;}
function stateCrecVal(nm){
  const key=stateMapeKey(nm);
  for(const [zm,ests] of Object.entries(ZM_ESTADOS)){
    if(ests.some(e=>e===key||e===nm))return CREC_ZM[zm];
  }
  return null;
}

let svgSelection=null;
function updateMapFill(){
  if(!svgSelection)return;
  svgSelection.attr('fill',function(){
    const nm=this.getAttribute('data-nm');
    if(mapMode==='mape') return colorMape(MAPE_ESTADO[stateMapeKey(nm)]??null);
    return colorCrec(stateCrecVal(nm));
  });
}
function updateLegend(){
  const bar=document.getElementById('lg-bar');
  const lo=document.getElementById('lg-lo'),hi=document.getElementById('lg-hi');
  if(mapMode==='mape'){
    bar.style.background='linear-gradient(to right,rgb(26,175,212),rgb(235,83,30))';
    lo.textContent='11% (mejor)';hi.textContent='49% (peor)';
