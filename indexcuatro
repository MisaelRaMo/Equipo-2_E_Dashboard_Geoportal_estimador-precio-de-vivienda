function calcularIntegral(){
  const lat=parseFloat(document.getElementById('lat').value)||19.4326;
  const lon=parseFloat(document.getElementById('lon').value)||-99.1332;
  const sc=parseFloat(document.getElementById('sup_cubierta').value)||120;
  const tipo=document.getElementById('tipo').value;
  const zonaSel=document.getElementById('zona').value;
  const comercio=parseInt(document.getElementById('comercio').value)||10;
  const esc=parseFloat(document.getElementById('escolaridad').value)||12;

  const zm=CENTROS_ZM.find(z=>z.id===zonaSel)||CENTROS_ZM[0];
  let base=zm.precio;
  base*=(sc/120)*0.55+0.45;
  base*=1+(esc-9)*0.012;
  if(comercio<=5)base*=1.02; else if(comercio>=40)base*=0.97;
  if(tipo==='apartment')base*=0.80; else if(tipo==='PH')base*=1.25;

  const mapeF=0.2363;
  const low=base*(1-mapeF), high=base*(1+mapeF);
  const tasaAnual=zm.crec/6/100;  // promedio anual simple sobre 6 años
