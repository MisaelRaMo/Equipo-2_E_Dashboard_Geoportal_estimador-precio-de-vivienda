function haversine(la1,lo1,la2,lo2){
  const R=6371,d2r=Math.PI/180;
  const dLat=(la2-la1)*d2r,dLon=(lo2-lo1)*d2r;
  const a=Math.sin(dLat/2)**2+Math.cos(la1*d2r)*Math.cos(la2*d2r)*Math.sin(dLon/2)**2;
  return R*2*Math.asin(Math.sqrt(a));
}
function nearestZM(lat,lon){
  let best=null,bestD=Infinity;
  CENTROS_ZM.forEach(z=>{const d=haversine(lat,lon,z.lat,z.lon);if(d<bestD){bestD=d;best=z;}});
  return best;
}

